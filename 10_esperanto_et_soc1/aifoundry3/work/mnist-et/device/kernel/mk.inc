        "fmv.x.w x0, f16\n"
        "fmv.x.w x0, f17\n"
        "nop\n"
        "fadd.ps f0, f0, f16\n"
        "fadd.ps f1, f1, f17\n"
        "fmv.x.w x0, f0\n"
        "fmv.x.w x0, f1\n"
        "nop\n"
        "addi %[r1], %[r1], -1\n"
        "bnez %[r1], 4b\n"
        "5:\n"
        "nop\n"
        "nop\n"
        "nop\n"
        "nop\n"
        "nop\n"
        "nop\n"
        "nop\n"
        "nop\n"
        "fswg.ps f0, (%[d])\n"
        "addi %[t0], %[d], 32\n"
        "fswg.ps f1, (%[t0])\n"
        : [a] "+r"(a), [r8] "+r"(r8), [r1] "+r"(r1), [t0] "=&r"(t0)
        : [d] "r"(d), [st] "r"(st)
        : "memory", FREGS);
}

