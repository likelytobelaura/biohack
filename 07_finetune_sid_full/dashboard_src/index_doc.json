{"text": "<style>\n.gx { display: flex; flex-direction: column; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n.gx-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.gx-head p { margin: var(--cds-gap-xs) 0 0; color: var(--color-fg-muted); max-width: 70ch; }\n.gx-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--cds-gap-md); }\n.gx-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n.gx-card h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.gx-note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: var(--cds-gap-xs) 0 var(--cds-gap-md); }\n.gx-label { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.gx-big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; margin-top: var(--cds-gap-xs); }\n.gx-sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-top: var(--cds-gap-xs); }\n.gx-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: var(--cds-gap-md); }\n.gx-chart { position: relative; min-height: 420px; }\n.gx-scatter { position: relative; min-height: 360px; }\n.gx-legend { display: flex; gap: var(--cds-gap-md); flex-wrap: wrap; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-bottom: var(--cds-gap-sm); }\n.gx-legend span { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n.gx-legend i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }\n.gx-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; z-index: 2; }\n.gx-tip .k { color: var(--cds-text-secondary); }\n.gx-tablebox { overflow-x: auto; }\n.gx table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-body); font-variant-numeric: tabular-nums; }\n.gx th, .gx td { text-align: right; padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.gx th:first-child, .gx td:first-child, .gx th:nth-child(2), .gx td:nth-child(2) { text-align: left; }\n.gx th { color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); font-size: var(--cds-font-size-caption); }\n.gx .up { color: var(--color-ok); } .gx .down { color: var(--color-bad); }\n.gx select { font: inherit; padding: var(--cds-pad-xs) var(--cds-pad-sm); border-radius: var(--cds-radius); border: 1px solid var(--color-border-line); background: var(--color-bg); color: var(--color-fg); }\n.gx-row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--cds-gap-sm); flex-wrap: wrap; }\n.gx-mb-tiles { margin: var(--cds-gap-md) 0; }\n.gx-mbchart { position: relative; min-height: 190px; margin-bottom: var(--cds-gap-md); }\n.gx-legend i.lg-b, .gx-legend i.lg-f { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n.gx-fail { display: flex; align-items: center; justify-content: center; gap: var(--cds-gap-xs); min-height: inherit; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.gx-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n</style>\n\n<div class=\"gx\">\n  <header class=\"gx-head\" id=\"top\">\n    <h1>Glimmer osteosarc eval: base vs fine-tuned</h1>\n    <p id=\"takeaway\" data-source=\"summary\" data-field=\"takeaway\" class=\"dash-skeleton\">\u2014</p>\n  </header>\n\n  <section class=\"gx-tiles\" id=\"tiles\">\n    <div class=\"gx-card\"><div class=\"gx-label\">Data types improved</div>\n      <div class=\"gx-big dash-skeleton\" data-source=\"summary\" data-field=\"improved_text\">\u2014</div>\n      <div class=\"gx-sub\">of 13, on each type's main metric</div></div>\n    <div class=\"gx-card\"><div class=\"gx-label\">Mean change in main metric</div>\n      <div class=\"gx-big dash-skeleton\" data-source=\"summary\" data-field=\"mean_delta_text\">\u2014</div>\n      <div class=\"gx-sub\">fine-tuned minus base, averaged over types</div></div>\n    <div class=\"gx-card\"><div class=\"gx-label\">Targets scored</div>\n      <div class=\"gx-big dash-skeleton\" data-source=\"summary\" data-field=\"targets_text\">\u2014</div>\n      <div class=\"gx-sub\">held-out values with a recovered true value</div></div>\n    <div class=\"gx-card\"><div class=\"gx-label\">Answer rate, fine-tuned</div>\n      <div class=\"gx-big dash-skeleton\" data-source=\"summary\" data-field=\"ft_answered_text\">\u2014</div>\n      <div class=\"gx-sub\" data-source=\"summary\" data-field=\"base_answered_text\">\u2014</div></div>\n  </section>\n\n  <section class=\"gx-card\" id=\"by-type\">\n    <h2>Main metric by data type</h2>\n    <p class=\"gx-note\">Spearman \u03c1 between predicted and true values; accuracy for multiplex IF (0/1 marker calls) and exact match for HLA alleles. Higher is better.</p>\n    <div class=\"gx-legend\"><span><i id=\"lg-base\"></i>Base model</span><span><i id=\"lg-ft\"></i>Fine-tuned (sid_full)</span></div>\n    <div class=\"gx-chart\" id=\"dumbbell\" data-source=\"scores\"></div>\n  </section>\n\n  <section class=\"gx-card\" id=\"table\">\n    <h2>Scores table</h2>\n    <p class=\"gx-note\">\"Within 10%\" counts predictions within 10% of the true value. Answered is the share of targets with a parseable prediction.</p>\n    <div class=\"gx-tablebox\">\n      <table data-source=\"scores\" data-row-key=\"data_type\">\n        <thead><tr>\n          <th data-field=\"data_type\">Data type</th><th data-field=\"metric\">Metric</th><th data-field=\"targets\">Targets</th>\n          <th data-field=\"base_primary\">Base</th><th data-field=\"ft_primary\">Fine-tuned</th><th data-field=\"delta\">Change</th>\n          <th data-field=\"base_within_10pct\">Base within 10%</th><th data-field=\"ft_within_10pct\">FT within 10%</th>\n          <th data-field=\"base_answered\">Base answered</th><th data-field=\"ft_answered\">FT answered</th>\n        </tr></thead>\n        <tbody id=\"tbody\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"gx-card\" id=\"microbiome\">\n    <h2>Microbiome (MetaPhlAn) deep dive</h2>\n    <p class=\"gx-note\">Read counts per species-level genome bin in stool and saliva samples. Every true value is above zero, since only detected species are listed. Typical error is the median fold difference between predicted and true counts.</p>\n    <p id=\"mb-takeaway\" class=\"dash-skeleton\" data-source=\"micro_summary\" data-field=\"takeaway\">\u2014</p>\n    <div class=\"gx-tiles gx-mb-tiles\">\n      <div><div class=\"gx-label\">Spearman \u03c1, all samples</div><div class=\"gx-big dash-skeleton\" data-source=\"micro_summary\" data-field=\"rho_text\">\u2014</div><div class=\"gx-sub\">base \u2192 fine-tuned</div></div>\n      <div><div class=\"gx-label\">Typical error</div><div class=\"gx-big dash-skeleton\" data-source=\"micro_summary\" data-field=\"fold_text\">\u2014</div><div class=\"gx-sub\">times off from the true count</div></div>\n      <div><div class=\"gx-label\">Predicted zero for a present species</div><div class=\"gx-big dash-skeleton\" data-source=\"micro_summary\" data-field=\"zero_text\">\u2014</div><div class=\"gx-sub\">base \u2192 fine-tuned</div></div>\n    </div>\n    <div class=\"gx-legend\"><span><i class=\"lg-b\"></i>Base model</span><span><i class=\"lg-f\"></i>Fine-tuned</span></div>\n    <div class=\"gx-mbchart\" id=\"mb-chart\" data-source=\"microbiome\"></div>\n    <div class=\"gx-tablebox\">\n      <table data-source=\"microbiome\" data-row-key=\"scope\">\n        <thead><tr>\n          <th data-field=\"scope\">Samples</th><th data-field=\"targets\">Targets</th>\n          <th data-field=\"base_spearman\">Base \u03c1</th><th data-field=\"ft_spearman\">FT \u03c1</th>\n          <th data-field=\"base_fold_off\">Base typical error</th><th data-field=\"ft_fold_off\">FT typical error</th>\n          <th data-field=\"base_within_10x\">Base within 10\u00d7</th><th data-field=\"ft_within_10x\">FT within 10\u00d7</th>\n          <th data-field=\"base_pred_zero\">Base predicted 0</th><th data-field=\"ft_pred_zero\">FT predicted 0</th>\n        </tr></thead>\n        <tbody id=\"mb-tbody\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"gx-card\" id=\"scatter-card\">\n    <div class=\"gx-row\"><h2>Predicted vs true</h2>\n      <label class=\"gx-label\" for=\"gx-type\">Data type <select id=\"gx-type\"></select></label></div>\n    <p class=\"gx-note\">Up to 400 sampled targets per model, on an asinh scale so zeros and large counts both fit. Points on the diagonal are exact.</p>\n    <div class=\"gx-legend\"><span><i id=\"lg-base2\"></i>Base model</span><span><i id=\"lg-ft2\"></i>Fine-tuned</span></div>\n    <div class=\"gx-scatter\" id=\"scatter\" data-source=\"points\"></div>\n  </section>\n</div>\n\n<script>\ndash.calc('summary', {\n  inputs: ['scores'],\n  title: 'Summary of the change',\n  description: 'Counts data types where the fine-tuned score beats the base score, and averages the change.',\n  fn: (scores) => {\n    const rows = scores.map(r => ({...r, base: Number(r.base_primary), ft: Number(r.ft_primary), n: Number(r.targets)}));\n    const both = rows.filter(r => Number.isFinite(r.base) && Number.isFinite(r.ft));\n    const improved = both.filter(r => r.ft > r.base).length;\n    const mean = both.length ? both.reduce((s, r) => s + (r.ft - r.base), 0) / both.length : 0;\n    const total = rows.reduce((s, r) => s + r.n, 0);\n    const wa = k => rows.reduce((s, r) => s + Number(r[k]) * r.n, 0) / total;\n    const f = x => (x >= 0 ? '+' : '\u2212') + Math.abs(x).toFixed(2);\n    const ftAns = rows.filter(r => r.ft_answered !== null && r.ft_answered !== undefined && r.ft_answered !== '');\n    if (!both.length) return [{\n      improved_text: '\u2013', mean_delta_text: '\u2013', targets_text: total.toLocaleString('en'),\n      ft_answered_text: '\u2013', base_answered_text: `base ${(wa('base_answered') * 100).toFixed(1)}%`,\n      takeaway: 'Fine-tuned results are still running. Base model scores are shown below; the fine-tuned column fills in when the eval finishes.'\n    }];\n    const best = both.slice().sort((a, b) => (b.ft - b.base) - (a.ft - a.base))[0];\n    const worst = both.slice().sort((a, b) => (a.ft - a.base) - (b.ft - b.base))[0];\n    return [{\n      improved_text: `${improved}`,\n      mean_delta_text: f(mean),\n      targets_text: total.toLocaleString('en'),\n      ft_answered_text: ftAns.length ? (wa('ft_answered') * 100).toFixed(1) + '%' : '\u2013',\n      base_answered_text: `base ${(wa('base_answered') * 100).toFixed(1)}%`,\n      takeaway: `Fine-tuning improved ${improved} of ${both.length} data types, by ${f(mean)} on average. Largest gain: ${best.data_type} (${f(best.ft - best.base)}). ` +\n        (worst.ft < worst.base ? `Largest drop: ${worst.data_type} (${f(worst.ft - worst.base)}).` : 'No data type got worse.')\n    }];\n  }\n});\n\ndash.calc('micro_summary', {\n  inputs: ['microbiome'],\n  title: 'Microbiome summary',\n  description: 'Before/after figures for all microbiome samples, and which sample type gained most.',\n  fn: (microbiome) => {\n    const all = microbiome.find(r => r.scope === 'All samples');\n    if (!all) return [];\n    const n = k => Number(all[k]);\n    const x = v => v >= 100 ? Math.round(v) + '\u00d7' : v.toFixed(1) + '\u00d7';\n    const site = microbiome.filter(r => r.scope !== 'All samples')\n      .map(r => ({ scope: r.scope, gain: Number(r.ft_spearman) - Number(r.base_spearman), b: Number(r.base_fold_off), f: Number(r.ft_fold_off) }));\n    const best = site.slice().sort((a, b) => (b.b / b.f) - (a.b / a.f))[0];\n    return [{\n      rho_text: `${n('base_spearman').toFixed(2)} \u2192 ${n('ft_spearman').toFixed(2)}`,\n      fold_text: `${x(n('base_fold_off'))} \u2192 ${x(n('ft_fold_off'))}`,\n      zero_text: `${(n('base_pred_zero') * 100).toFixed(0)}% \u2192 ${(n('ft_pred_zero') * 100).toFixed(0)}%`,\n      takeaway: `Fine-tuning cut the typical count error from ${x(n('base_fold_off'))} to ${x(n('ft_fold_off'))} off, mostly by no longer predicting zero for species that were present (${(n('base_pred_zero') * 100).toFixed(0)}% of answers before, ${(n('ft_pred_zero') * 100).toFixed(0)}% after). ` +\n        `${best.scope} gained most (typical error ${x(best.b)} \u2192 ${x(best.f)}). ` +\n        site.filter(r => r.gain < 0).map(r => `${r.scope} ranking dipped slightly (\u03c1 ${r.gain.toFixed(2)}).`).join(' ')\n    }];\n  }\n});\n\n(function () {\n  const C = () => ({ base: 'var(--cds-chart-muted)', ft: dash.colors[0] });\n  const fmt = (x, d = 3) => (x === null || x === undefined || x === '' || isNaN(Number(x))) ? '\u2013' : Number(x).toFixed(d);\n  const pct = x => (x === null || x === undefined || x === '' || isNaN(Number(x))) ? '\u2013' : (Number(x) * 100).toFixed(1) + '%';\n  const fail = el => { el.innerHTML = ''; const d = document.createElement('div'); d.className = 'gx-fail'; d.textContent = 'Failed to load'; el.appendChild(d); };\n  let selected = null;\n\n  function tiles() {\n    const s = dash.data('summary');\n    document.querySelectorAll('[data-source=\"summary\"]').forEach(el => {\n      if (s.status === 'ok' && s.data[0]) { el.textContent = s.data[0][el.dataset.field]; el.classList.remove('dash-skeleton'); }\n      else if (s.status === 'error') { el.textContent = '\u2014'; el.classList.remove('dash-skeleton'); }\n      else el.textContent = '\u2014';\n    });\n  }\n\n  function dumbbell(rows) {\n    const box = document.getElementById('dumbbell'); box.innerHTML = '';\n    const W = box.clientWidth || 600, rowH = 30, m = { t: 22, r: 16, b: 8 };\n    const svg = d3.select(box).append('svg').attr('width', '100%');\n    const probe = svg.append('text').attr('font-size', 12).text('');\n    let labelW = 0;\n    rows.forEach(r => { probe.text(r.data_type); labelW = Math.max(labelW, probe.node().getComputedTextLength()); });\n    probe.remove();\n    m.l = labelW + 14;\n    const H = m.t + rows.length * rowH + m.b;\n    svg.attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);\n    const vals = rows.flatMap(r => [Number(r.base_primary), Number(r.ft_primary)]).filter(Number.isFinite);\n    const x = d3.scaleLinear([Math.min(0, d3.min(vals)), 1], [m.l, W - m.r]);\n    const y = d3.scaleBand(rows.map(r => r.data_type), [m.t, H - m.b]).padding(0.3);\n    const ticks = x.ticks(W < 450 ? 4 : 6);\n    svg.append('g').selectAll('line').data(ticks).join('line')\n      .attr('x1', d => x(d)).attr('x2', d => x(d)).attr('y1', m.t - 4).attr('y2', H - m.b).attr('stroke', 'var(--cds-chart-grid)');\n    svg.append('g').selectAll('text').data(ticks).join('text')\n      .attr('x', d => x(d)).attr('y', m.t - 8).attr('text-anchor', 'middle').attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').text(d => d.toFixed(1));\n    const tip = d3.select(box).append('div').attr('class', 'gx-tip').style('display', 'none');\n    const g = svg.append('g').selectAll('g').data(rows).join('g').attr('transform', r => `translate(0,${y(r.data_type) + y.bandwidth() / 2})`);\n    g.append('text').attr('x', m.l - 10).attr('dy', '0.35em').attr('text-anchor', 'end').attr('font-size', 12).attr('fill', 'var(--color-fg)').text(r => r.data_type);\n    const has = r => r.ft_primary !== null && r.ft_primary !== undefined && r.ft_primary !== '';\n    g.filter(has).append('line').attr('x1', r => x(Number(r.base_primary))).attr('x2', r => x(Number(r.ft_primary)))\n      .attr('stroke', r => Number(r.ft_primary) >= Number(r.base_primary) ? C().ft : 'var(--cds-chart-status-critical)').attr('stroke-width', 2).attr('stroke-linecap', 'round').attr('opacity', .6);\n    g.append('circle').attr('cx', r => x(Number(r.base_primary))).attr('r', 5).attr('fill', C().base);\n    g.filter(has).append('circle').attr('cx', r => x(Number(r.ft_primary))).attr('r', 6).attr('fill', C().ft);\n    g.append('rect').attr('x', 0).attr('y', -rowH / 2).attr('width', W).attr('height', rowH).attr('fill', 'transparent')\n      .on('mousemove', (ev, r) => {\n        const [px, py] = d3.pointer(ev, box);\n        tip.style('display', null).html('');\n        tip.append('div').attr('class', 'k').text(`${r.data_type} \u00b7 ${r.metric}`);\n        tip.append('div').text(`Base ${fmt(r.base_primary)}`);\n        tip.append('div').text(`Fine-tuned ${fmt(r.ft_primary)}`);\n        tip.append('div').text(`Change ${Number(r.delta) >= 0 ? '+' : ''}${fmt(r.delta)}`);\n        const tw = tip.node().offsetWidth;\n        tip.style('left', Math.min(px + 12, box.clientWidth - tw - 4) + 'px').style('top', (py + 12) + 'px');\n      })\n      .on('mouseleave', () => tip.style('display', 'none'));\n  }\n\n  function table(rows) {\n    const tb = document.getElementById('tbody'); tb.innerHTML = '';\n    rows.forEach(r => {\n      const tr = document.createElement('tr');\n      const cells = [r.data_type, r.metric, Number(r.targets).toLocaleString('en'), fmt(r.base_primary), fmt(r.ft_primary),\n        (r.delta === null || r.delta === undefined) ? '\u2013' : (Number(r.delta) >= 0 ? '+' : '') + fmt(r.delta), pct(r.base_within_10pct), pct(r.ft_within_10pct), pct(r.base_answered), pct(r.ft_answered)];\n      cells.forEach((c, i) => {\n        const td = document.createElement('td'); td.textContent = c;\n        if (i === 5 && !isNaN(Number(r.delta))) td.className = Number(r.delta) > 0.005 ? 'up' : Number(r.delta) < -0.005 ? 'down' : '';\n        tr.appendChild(td);\n      });\n      tb.appendChild(tr);\n    });\n  }\n\n  function scatter(pts, types) {\n    const sel = document.getElementById('gx-type');\n    if (!sel.options.length) {\n      types.forEach(t => { const o = document.createElement('option'); o.value = t; o.textContent = t; sel.appendChild(o); });\n      sel.addEventListener('change', () => { selected = sel.value; draw(); });\n    }\n    if (!selected) selected = types.includes('Bulk RNA-seq TPM') ? 'Bulk RNA-seq TPM' : types[0];\n    sel.value = selected;\n    const box = document.getElementById('scatter'); box.innerHTML = '';\n    const data = pts.filter(p => p.data_type === selected).map(p => ({ m: p.model, t: Math.asinh(Number(p.truth)), p: Math.asinh(Number(p.pred)), rt: Number(p.truth), rp: Number(p.pred) }))\n      .filter(d => Number.isFinite(d.t) && Number.isFinite(d.p));\n    const W = box.clientWidth || 500, H = Math.min(420, Math.max(300, W * 0.7)), m = { t: 10, r: 14, b: 36, l: 48 };\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);\n    const lo = d3.min(data, d => Math.min(d.t, d.p)) ?? 0, hi = d3.max(data, d => Math.max(d.t, d.p)) ?? 1;\n    const x = d3.scaleLinear([lo, hi], [m.l, W - m.r]).nice(), y = d3.scaleLinear([lo, hi], [H - m.b, m.t]).nice();\n    const fmtTick = v => { const r = Math.sinh(v); return Math.abs(r) >= 1000 ? d3.format('.2s')(r) : d3.format('.2~g')(r); };\n    svg.append('g').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(W < 450 ? 4 : 6).tickFormat(fmtTick))\n      .attr('font-size', null).attr('font-family', null).call(g => g.selectAll('text').attr('fill', 'var(--color-fg-muted)').attr('font-size', 11))\n      .call(g => g.selectAll('line,path').attr('stroke', 'var(--cds-chart-axis)'));\n    svg.append('g').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(5).tickFormat(fmtTick))\n      .attr('font-size', null).attr('font-family', null).call(g => g.selectAll('text').attr('fill', 'var(--color-fg-muted)').attr('font-size', 11))\n      .call(g => g.selectAll('line,path').attr('stroke', 'var(--cds-chart-axis)'));\n    svg.append('line').attr('x1', x(lo)).attr('y1', y(lo)).attr('x2', x(hi)).attr('y2', y(hi)).attr('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '4 4');\n    svg.append('text').attr('x', (m.l + W - m.r) / 2).attr('y', H - 4).attr('text-anchor', 'middle').attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').text('True value');\n    svg.append('text').attr('transform', `translate(12,${(m.t + H - m.b) / 2}) rotate(-90)`).attr('text-anchor', 'middle').attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').text('Predicted');\n    ['base', 'ft'].forEach(mm => svg.append('g').selectAll('circle').data(data.filter(d => d.m === mm)).join('circle')\n      .attr('cx', d => x(d.t)).attr('cy', d => y(d.p)).attr('r', 2.6).attr('fill', mm === 'ft' ? C().ft : C().base).attr('opacity', mm === 'ft' ? .7 : .55));\n    const tip = d3.select(box).append('div').attr('class', 'gx-tip').style('display', 'none');\n    const del = d3.Delaunay.from(data, d => x(d.t), d => y(d.p));\n    svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b).attr('fill', 'transparent')\n      .on('mousemove', ev => {\n        const [px, py] = d3.pointer(ev, svg.node()); const i = del.find(px, py); const d = data[i]; if (!d) return;\n        const [bx, by] = d3.pointer(ev, box);\n        tip.style('display', null).html('');\n        tip.append('div').attr('class', 'k').text(d.m === 'ft' ? 'Fine-tuned' : 'Base model');\n        tip.append('div').text(`True ${d3.format('.4~g')(d.rt)}`);\n        tip.append('div').text(`Predicted ${d3.format('.4~g')(d.rp)}`);\n        const tw = tip.node().offsetWidth;\n        tip.style('left', Math.min(bx + 12, box.clientWidth - tw - 4) + 'px').style('top', (by + 12) + 'px');\n      })\n      .on('mouseleave', () => tip.style('display', 'none'));\n  }\n\n  function microbiome(rows) {\n    const tb = document.getElementById('mb-tbody'); tb.innerHTML = '';\n    rows.forEach(r => {\n      const tr = document.createElement('tr');\n      const fx = v => { const n = Number(v); return n >= 100 ? Math.round(n) + '\u00d7' : n.toFixed(1) + '\u00d7'; };\n      [r.scope, Number(r.targets).toLocaleString('en'), fmt(r.base_spearman), fmt(r.ft_spearman), fx(r.base_fold_off), fx(r.ft_fold_off),\n       pct(r.base_within_10x), pct(r.ft_within_10x), pct(r.base_pred_zero), pct(r.ft_pred_zero)].forEach(c => {\n        const td = document.createElement('td'); td.textContent = c; tr.appendChild(td); });\n      tb.appendChild(tr);\n    });\n    const box = document.getElementById('mb-chart'); box.innerHTML = '';\n    const W = box.clientWidth || 500, rowH = 52, m = { t: 22, r: 56, b: 6, l: 0 };\n    const svg = d3.select(box).append('svg').attr('width', '100%');\n    const probe = svg.append('text').attr('font-size', 12);\n    rows.forEach(r => { probe.text(r.scope); m.l = Math.max(m.l, probe.node().getComputedTextLength()); });\n    probe.remove(); m.l += 14;\n    const H = m.t + rows.length * rowH + m.b;\n    svg.attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);\n    const maxv = d3.max(rows, r => Math.max(Number(r.base_fold_off), Number(r.ft_fold_off)));\n    const x = d3.scaleLog([1, Math.max(10, maxv * 1.2)], [m.l, W - m.r]);\n    const ticks = [1, 10, 100, 1000, 10000].filter(t => t <= x.domain()[1]);\n    svg.append('g').selectAll('line').data(ticks).join('line').attr('x1', d => x(d)).attr('x2', d => x(d)).attr('y1', m.t - 4).attr('y2', H - m.b).attr('stroke', 'var(--cds-chart-grid)');\n    svg.append('g').selectAll('text').data(ticks).join('text').attr('x', d => x(d)).attr('y', m.t - 8).attr('text-anchor', 'middle')\n      .attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').text(d => d3.format(',')(d) + '\u00d7');\n    const g = svg.append('g').selectAll('g').data(rows).join('g').attr('transform', (r, i) => `translate(0,${m.t + i * rowH})`);\n    g.append('text').attr('x', m.l - 10).attr('y', rowH / 2).attr('dy', '0.35em').attr('text-anchor', 'end').attr('font-size', 12).attr('fill', 'var(--color-fg)').text(r => r.scope);\n    [['base_fold_off', C().base, 8], ['ft_fold_off', C().ft, 26]].forEach(([k, col, y0]) => {\n      g.append('rect').attr('x', m.l).attr('y', y0).attr('height', 14).attr('rx', 4).attr('fill', col)\n        .attr('width', r => Math.max(2, x(Math.max(1, Number(r[k]))) - m.l));\n      g.append('text').attr('x', r => x(Math.max(1, Number(r[k]))) + 6).attr('y', y0 + 7).attr('dy', '0.35em').attr('font-size', 11)\n        .attr('fill', 'var(--color-fg-muted)').text(r => { const n = Number(r[k]); return (n >= 100 ? Math.round(n) : n.toFixed(1)) + '\u00d7'; });\n    });\n  }\n\n  let lastPts = null, lastTypes = [];\n  function draw() { if (lastPts) scatter(lastPts, lastTypes); }\n\n  dash.onData(() => {\n    ['lg-base', 'lg-base2'].forEach(id => document.getElementById(id).style.background = C().base);\n    ['lg-ft', 'lg-ft2'].forEach(id => document.getElementById(id).style.background = C().ft);\n    tiles();\n    const s = dash.data('scores');\n    const db = document.getElementById('dumbbell');\n    if (s.status === 'ok') {\n      const key = r => (r.ft_primary === null || r.ft_primary === undefined || r.ft_primary === '') ? Number(r.base_primary) : Number(r.ft_primary);\n      const rows = s.data.slice().sort((a, b) => key(b) - key(a));\n      dumbbell(rows); table(rows);\n    } else if (s.status === 'error') { fail(db); document.getElementById('tbody').innerHTML = ''; }\n    else { db.innerHTML = ''; document.getElementById('tbody').innerHTML = ''; }\n    document.querySelectorAll('.lg-b').forEach(e => e.style.background = C().base);\n    document.querySelectorAll('.lg-f').forEach(e => e.style.background = C().ft);\n    const ms = dash.data('micro_summary');\n    document.querySelectorAll('[data-source=\"micro_summary\"]').forEach(el => {\n      if (ms.status === 'ok' && ms.data[0]) { el.textContent = ms.data[0][el.dataset.field]; el.classList.remove('dash-skeleton'); }\n      else { el.textContent = '\u2014'; if (ms.status === 'error') el.classList.remove('dash-skeleton'); }\n    });\n    const mb = dash.data('microbiome'); const mbBox = document.getElementById('mb-chart');\n    if (mb.status === 'ok') microbiome(mb.data);\n    else if (mb.status === 'error') { fail(mbBox); document.getElementById('mb-tbody').innerHTML = ''; }\n    else { mbBox.innerHTML = ''; document.getElementById('mb-tbody').innerHTML = ''; }\n    const p = dash.data('points'); const sc = document.getElementById('scatter');\n    if (p.status === 'ok') {\n      lastPts = p.data;\n      lastTypes = s.status === 'ok' ? s.data.filter(r => r.key !== 'hla').map(r => r.data_type) : [...new Set(p.data.map(d => d.data_type))];\n      draw();\n    } else if (p.status === 'error') fail(sc);\n    else sc.innerHTML = '';\n  });\n})();\n</script>\n"}